# systemd --user unit for the live mudhost. Generated by `make service-install`;
# @WORKDIR@ and @BIN@ are filled in from the Makefile (CURDIR, DEPLOY_BIN).
#
# The service runs a deployed COPY of the binary (@BIN@), never bin/mudhost:
# `make build` and the E2E wrappers rebuild bin/mudhost freely, and that must not
# change what the live service runs (or what it picks up on a crash restart).
# Ship a new version only with `make deploy`.
[Unit]
Description=rubymud mudhost (MUD host + browser client)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@WORKDIR@
# Optional MUDHOST_* settings (MCP, basic auth), one KEY=value per line.
EnvironmentFile=-%h/.config/rubymud/env
# --mud mirrors `make run`: the existing "default" session keeps its own saved
# host and is auto-connected on start; the address only seeds a fresh database.
ExecStart=@BIN@ --db @WORKDIR@/data/mudhost.db --mud 127.0.0.1:4000
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
